{
  "name": "dsh-connect-sensenova-token-plan",
  "displayName": "DSH Connect SenseNova Token Plan",
  "version": "0.4.0",
  "description": "SenseNova Token Plan credit panel for the Harness Web UI: per-pool quota windows and per-model consumption from the console API, with an in-panel account setup and a self-renewing console token.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sensenova",
    "token-plan",
    "credits",
    "quota"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./sensenova-auth": "./sensenova-auth.js",
    "./token-store": "./token-store.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "codes.js",
    "client.js",
    "console-client.js",
    "host-config.js",
    "parsers.js",
    "throttle-store.js",
    "catalog-store.js",
    "provider-store.js",
    "provider-publish.js",
    "snapshot-aggregate.js",
    "api-key-store.js",
    "llm-models.js",
    "llm-adapter.js",
    "llm-retry.js",
    "draw.js",
    "trace.js",
    "util.js",
    "sensenova-auth.js",
    "sensenova-crypto.js",
    "token-store.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node test/auth.test.mjs && node test/store.test.mjs && node test/routes.test.mjs && node test/panel.test.mjs && node test/render.test.mjs && node test/parsers.test.mjs && node test/provider.test.mjs && node test/config.test.mjs && node test/package.test.mjs && node test/docs.test.mjs && node test/wiring.test.mjs && node test/contract.test.mjs && node test/e2e-gate.mjs",
    "test:live": "node test/live-jwks.test.mjs",
    "test:live:contract": "node test/live-contract.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-llm": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-settings": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-tools": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.5 <0.3",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^0.85.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eghrhegpe/dsh-connect-sensenova-token-plan.git"
  },
  "license": "MIT"
}
