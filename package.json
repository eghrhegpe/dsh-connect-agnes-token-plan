{
  "name": "dsh-connect-agnes-token-plan",
  "displayName": "DSH Connect Agnes Token Plan",
  "icon": "./icon.svg",
  "version": "0.10.1",
  "description": "Agnes connect bundle for the Harness Web UI: Token Plan quota panel (account-wide quota windows, cumulative usage, console sign-in) plus optional provider registration that brings Agnes models into DSH conversation, with host-side rate-limit self-healing.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agnes",
    "token-plan",
    "credits",
    "quota"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "icon.svg",
    "locale",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "screenshots.json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:client": "tsdown -c tsdown.config.mjs",
    "test": "node test/run.mjs",
    "test:live:contract": "node test/live-contract.mjs",
    "test:live:agnescode": "node test/live-agnescode.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:errorfix": "node test/run.mjs --only error-fix",
    "test:peer-contract": "node test/run.mjs --only peer-contract",
    "doctor": "node tools/doctor.mjs",
    "doctor:json": "node tools/doctor.mjs --json",
    "lint:dup": "jscpd src --min-tokens 70 --threshold 3 --reporters console",
    "lint:commits": "commitlint --from HEAD~1 --to HEAD",
    "build": "tsdown -c tsdown.config.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-credentials": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-llm": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-settings": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-tools": ">=0.1.5 <0.3",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^0.85.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eghrhegpe/dsh-connect-agnes-token-plan.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.3",
    "jscpd": "^5.4.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  }
}
