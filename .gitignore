# 凭据与本机状态：绝不进版本库
.env
.env.*
*.env
# 运行时产物
*.log
logs/
tmp/

# Box-Agent 运行时任务状态：本机自动写入，绝不进版本库
.box-agent/
.box-agent-scratch/
.zcode/
.agnes/

# 门禁机器产物：dup-gate 的 jscpd 把克隆报告默认写到 `report/`（test/dup-gate.mjs）。
# 同属 PITFALLS §10「探针产物可以落、但绝不留在仓库根的未跟踪区」——与上面
# `probe-asar/` 那次事故同一类：未被忽略的目录，一次 `git add -A` 就进历史。
/report/

# build-gate 跑完即删的临时构建配置（防御性忽略：万一中途被强杀，残留物不该进
# 版本库，也不该让人误以为那是手工产物）。其暂存产物落在上面已忽略的 `tmp/`。
.build-gate.config.mjs

# 依赖与构建（link 安装下通常没有实体目录，保险起见）
node_modules/
dist/
build/
*.tsbuildinfo
# 本仓无 lockfile by design（peerDependencies 无 registry 可解析，CI 按 package.json 做
# npm 缓存）；一次 npm install 会在仓库根生成 package-lock.json，它若不忽略就是本文件末尾
# 「未跟踪也未忽略、一次 git add -A 卷进历史」那条纪律描述的裸区形状。
package-lock.json

# 构建产物：lib/ 与根 client.js 由 `prepare`（=`npm run build`，tsdown）在安装/发布时
# 现场构建，**不入库**（本仓 2026-11-18 起随 ADR-022 改为不入库，取代 ADR-008 的
# 「随库提交」；账本条目 docs/ADR.md 的 ADR-022）。
# 为什么不入库（完整理由，别只记半句）：DSH 市场 / `dsh plugin add` 的 git 直装走
# pnpm git-dep 管线，pnpm 对 git 依赖只在 allowBuilds 批准后跑 prepare——未批准报
# ERR_PNPM_GIT_DEP_PREPARE_NOT_ALLOWED（pnpm 打印要加的那行）。装插件的用户把该行
# 加进 `~/.dsh/profiles/<profile>/pnpm-workspace.yaml` 的 allowBuilds（见 README 安装节），
# prepare 现场重建 lib/ 与 client.js，装出来的包就不缺 main 入口（./lib/index.js）。
# 纪律：产物只由构建生成、禁止手改——改 src/ 后必跑 `npm run build`；本地门禁
# test/build-gate.mjs 把 src/ 重建到 gitignored 的暂存目录与磁盘产物逐字节比对（不碰工作树）。
lib/
client.js
# 产物命名用 `chunkFileNames: "[name].js"`（不含内容哈希，见 tsdown.config.mjs）：
# 改源码是**原地修改**而非删旧加新，diff 只出 1 个 M，不出 D + ?? 对。

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 参照件容器：每个参照件各占一个「用各自仓库原名」的子目录（如 upstream/AgnesCode2Api/），
# 各自带独立 .git 与 remote；本机快照（无 .git，如桌面端 asar 解包 upstream/AgnesCode-desktop-1.0.68/）
# 与探测脚本也一律落在这里，**绝不留在仓库根的未跟踪区**——2026-10-01 复盘：根下 110M 的
# probe-asar/ 既未跟踪也未忽略，一次 `git add -A` 就会把它卷进历史。
# 仅本地容纳、绝不进本仓库历史；保持各嵌套 .git 完好即可独立提交/推送。
# 以后要塞别的参照件，直接在 upstream/ 下并排加子目录即可，无需改此规则。清单见 docs/REFERENCES.md。
/upstream/
